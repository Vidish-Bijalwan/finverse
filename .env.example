# Supabase — get these from the Supabase dashboard (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay — server-only, test mode keys only (never commit real values).
# Get test keys from the Razorpay dashboard (Test Mode → Settings → API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Supabase service-role key — server-only. Needed by the Razorpay webhook
# (src/routes/api.razorpay-webhook.tsx) to write payments + ledger rows for
# the paying user, since webhooks carry no user session. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
